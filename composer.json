{
  "name": "mpanius/laravel-redis-geoip",
  "description": "Native Redis GeoIP country lookups for Laravel using Redis Functions and IPLocate CSV imports.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/mpanius/laravel-redis-geoip",
  "keywords": [
    "geoip",
    "redis",
    "laravel",
    "iplocate",
    "phpredis"
  ],
  "authors": [
    {
      "name": "Mikhail Panyushkin",
      "homepage": "https://github.com/mpanius"
    }
  ],
  "require": {
    "php": "^8.3|^8.4",
    "ext-redis": "*",
    "illuminate/cache": "^11.0|^12.0",
    "illuminate/console": "^11.0|^12.0",
    "illuminate/contracts": "^11.0|^12.0",
    "illuminate/redis": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0",
    "spatie/laravel-package-tools": "^1.93"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Mpanius\\LaravelRedisGeoIp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mpanius\\LaravelRedisGeoIp\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mpanius\\LaravelRedisGeoIp\\LaravelRedisGeoIpServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit"
  },
  "support": {
    "issues": "https://github.com/mpanius/laravel-redis-geoip/issues",
    "source": "https://github.com/mpanius/laravel-redis-geoip"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
